# Supply-chain hardening (WALLET-1351, Phase 1).
# Disable ALL npm lifecycle scripts on install — dependency install scripts
# (preinstall/install/postinstall) AND this package's own scripts (e.g. the
# `prepare`/husky hook). Approved dependency install scripts are run explicitly
# via `@lavamoat/allow-scripts` (see the `lavamoat.allowScripts` allowlist in
# package.json). Run `npm run setup` for a full local install that also wires
# up git hooks. See the "Install dependencies" section in README.md.
ignore-scripts=true
